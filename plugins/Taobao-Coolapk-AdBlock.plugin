#!name = 去广告·淘宝/天猫/酷安
#!desc = 拦截淘宝、天猫、酷安中仍在放行的广告 SDK（阿里妈妈 Tanx、穿山甲、京东联盟）、埋点上报、设备指纹与推广落地页。规则由真实抓包 30_1791116195395 生成，6 个开关可按需裁剪。
#!author = imacte
#!homepage = https://github.com/imacte/Loon-plugins
#!icon = https://raw.githubusercontent.com/imacte/Loon-plugins/main/icons/Taobao-Coolapk-AdBlock.png
#!system = iOS,iPadOS,macOS
#!system_version = 15.0
#!loon_version = 3.5.1(978)
#!tag = 去广告,淘宝,天猫,酷安
#!type = normal

[Argument]
AdSDK = switch,true,tag=广告SDK(Tanx/穿山甲/京东联盟),desc=拦掉酷安内嵌的三家广告 SDK 及广告归因
Tracker = switch,true,tag=埋点统计与日志上报,desc=mmstat 埋点、支付宝日志网关、阿里云 SLS、字节 APM
TaobaoAd = switch,true,tag=淘宝天猫广告接口,desc=ADASHX 广告位、阿里妈妈素材，以及 amdc 的 IP 直连绕过
DeviceId = switch,true,tag=设备指纹(fourier/umid),desc=fourier 指纹脚本与阿里 UMID，风控影响很小
AliSec = switch,false,tag=阿里安全验证(可能影响登录),desc=alibabachengdun 系列，拦狠了可能出现登录异常或系统繁忙
Promo = switch,false,tag=推广弹窗与广告落地页,desc=会连带干掉正常的天猫活动页，按需开启

[Rewrite]

# ═══════════ 1. 广告 SDK ═══════════

# 阿里妈妈 Tanx：sdk-config.tanx.com/requestConfigV2，以及 df/ifs/kgb-ifs/bdlog/mmstl-tianhe.tanx.com
request if ${AdSDK} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+\.)?tanx\.com\// then reject_dict(200)

# 穿山甲(Pangle)广告设置，响应含 pangle_site_id
request if ${AdSDK} == true && ${url} ~= /^https?:\/\/webcast-open\.douyin\.com\/webcast\/openapi\/pangle\// then reject_dict(200)
# 穿山甲可播放广告组件 SDK
request if ${AdSDK} == true && ${url} ~= /^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad\// then reject(200)
# 穿山甲 SDK 上报，subaid 与 pangle_site_id 一致
request if ${AdSDK} == true && ${url} ~= /^https?:\/\/mssdk\.volces\.com\/ri\// then reject(200)
# 字节域名调度，穿山甲 aid=1371 / 4741
request if ${AdSDK} == true && ${url} ~= /^https?:\/\/tnc[0-9]-[a-z0-9-]+\.zijieapi\.com\/get_domains\// then reject_dict(200)

# 京东开普勒·联盟推广，响应头 pfinder 标记 unionpromotionmedia
request if ${AdSDK} == true && ${url} ~= /^https?:\/\/dg\.k\.jd\.com\/getConfigNew/ then reject_dict(200)
request if ${AdSDK} == true && ${url} ~= /^https?:\/\/dg\.k\.jd\.com\// then reject(200)
request if ${AdSDK} == true && ${url} ~= /^https?:\/\/dgstatic\.jd\.com\// then reject(200)

# 数盟 IDFA 设备标识，广告归因
request if ${AdSDK} == true && ${url} ~= /^https?:\/\/idfa2\.shuzilm\.cn\// then reject_dict(200)
# 中国移动 IDAA 广告归因上报
request if ${AdSDK} == true && ${url} ~= /^https?:\/\/iuni\.telecome\.cn\/i\/idaa\// then reject(200)

# ═══════════ 2. 淘宝 / 天猫 广告接口 ═══════════

# amdc 的裸 IP 直连（http://59.82.99.x:80 + Host 也是 IP）会绕过域名规则，按路径兜底
request if ${TaobaoAd} == true && ${url} ~= /\/amdc\/mobileDispatch/ then reject(404)
request if ${TaobaoAd} == true && ${url} ~= /\/amdc\/ipDispatch/ then reject(404)

# 阿里妈妈广告位 ADASHX
request if ${TaobaoAd} == true && ${url} ~= /^https?:\/\/adashx\.m\.taobao\.com\// then reject_dict(200)
request if ${TaobaoAd} == true && ${url} ~= /^https?:\/\/h-adashx\.ut\.taobao\.com\// then reject_dict(200)

# 广告视频与素材
request if ${TaobaoAd} == true && ${url} ~= /^https?:\/\/alimama\.cloudvideocdn\.taobao\.com\// then reject(200)
request if ${TaobaoAd} == true && ${url} ~= /^https?:\/\/mamasearchad\.cloudvideocdn\.taobao\.com\// then reject(200)
request if ${TaobaoAd} == true && ${url} ~= /^https?:\/\/admedia\.elemecdn\.com\// then reject(200)
request if ${TaobaoAd} == true && ${url} ~= /^https?:\/\/o2o-ad-dev\.oss-cn-shanghai\.aliyuncs\.com\// then reject(200)

# ═══════════ 3. 埋点 / 统计 / 日志上报 ═══════════

# gm.mmstat.com/jstracker.3，淘宝最活跃的埋点通道
request if ${Tracker} == true && ${url} ~= /^https?:\/\/gm\.mmstat\.com\// then reject(200)
# log.mmstat.com/eg.js，由 orange.tbcdn.cn 下发的配置引用
request if ${Tracker} == true && ${url} ~= /^https?:\/\/log\.mmstat\.com\// then reject(200)
request if ${Tracker} == true && ${url} ~= /^https?:\/\/s-gm\.mmstat\.com\// then reject(200)
request if ${Tracker} == true && ${url} ~= /^https?:\/\/wgo\.mmstat\.com\// then reject(200)

# 支付宝日志网关
request if ${Tracker} == true && ${url} ~= /^https?:\/\/loggw-ex\.alipay\.com\/loggw\// then reject(200)
request if ${Tracker} == true && ${url} ~= /^https?:\/\/gw\.alipayobjects\.com\/config\/loggw\// then reject(200)

# 阿里云 SLS 上报
request if ${Tracker} == true && ${url} ~= /^https?:\/\/client-upload\.[a-z0-9-]+\.log\.aliyuncs\.com\// then reject(200)
request if ${Tracker} == true && ${url} ~= /^https?:\/\/impaas-for-client\.[a-z0-9-]+\.log\.aliyuncs\.com\// then reject(200)

# 字节 APM 监控
request if ${Tracker} == true && ${url} ~= /^https?:\/\/apmplus\.volces\.com\// then reject(200)

# 阿里云 VOD 播放许可（抖音直播插件用），不需要可删掉本行
request if ${Tracker} == true && ${url} ~= /^https?:\/\/vod-license-m\.volccdn\.com\/vod-license\// then reject(200)

# ═══════════ 4. 设备指纹 ═══════════

# fourier.taobao.com/rp 返回 JS 写 xlly_s 指纹 Cookie 并向 gm.mmstat.com 上报。
# 先捕获 callback 名回一个合法空 JSONP，避免 WebView 报 JS 语法错；下一条兜底。
request if ${DeviceId} == true && ${url} ~= /^https?:\/\/fourier\.taobao\.com\/rp\?[^#]*callback=([A-Za-z0-9_$.]+)/ as cb then reject(200, "${cb.1}({});")
request if ${DeviceId} == true && ${url} ~= /^https?:\/\/fourier\.taobao\.com\/rp/ then reject(200, "void(0);")
request if ${DeviceId} == true && ${url} ~= /^https?:\/\/fourier\.alibaba\.com\// then reject(200, "void(0);")
# 阿里 UMID 设备指纹
request if ${DeviceId} == true && ${url} ~= /^https?:\/\/cdn\.ynuf\.aliapp\.org\// then reject_dict(200)
# 饿了么设备指纹
request if ${DeviceId} == true && ${url} ~= /^https?:\/\/alsc-fingerprint\.ele\.me\// then reject(200)

# ═══════════ 5. 阿里安全 / 无痕验证（默认关闭） ═══════════

request if ${AliSec} == true && ${url} ~= /^https?:\/\/mum\.alibabachengdun\.com\// then reject(200)
request if ${AliSec} == true && ${url} ~= /^https?:\/\/mum-init\.alibabachengdun\.com\// then reject(200)
request if ${AliSec} == true && ${url} ~= /^https?:\/\/umdc\.alibabachengdun\.com\// then reject(200)

# ═══════════ 6. 推广弹窗 / 广告落地页（默认关闭） ═══════════

# 天猫推广落地页，URL 带 dpa_material_id / bc_fl_src 广告素材号
request if ${Promo} == true && ${url} ~= /^https?:\/\/pages\.tmall\.com\/wow\/bz\/jingmi\// then reject(204)
# 淘宝 DinamicX 车型确认弹窗模板
request if ${Promo} == true && ${url} ~= /^https?:\/\/dinamicx\.alibabausercontent\.com\/pub\/dxm_vehicle_model_confirm\// then reject(204)

[MitM]
hostname = %APPEND% sdk-config.tanx.com, *.tanx.com, webcast-open.douyin.com, lf-cdn-tos.bytescm.com, mssdk.volces.com, apmplus.volces.com, *.zijieapi.com, dg.k.jd.com, dgstatic.jd.com, idfa2.shuzilm.cn, iuni.telecome.cn, amdc.m.taobao.com, adashx.m.taobao.com, h-adashx.ut.taobao.com, *.cloudvideocdn.taobao.com, *.mmstat.com, loggw-ex.alipay.com, gw.alipayobjects.com, *.log.aliyuncs.com, fourier.taobao.com, fourier.alibaba.com, cdn.ynuf.aliapp.org, *.alibabachengdun.com, pages.tmall.com, dinamicx.alibabausercontent.com, admedia.elemecdn.com, vod-license-m.volccdn.com, alsc-fingerprint.ele.me
