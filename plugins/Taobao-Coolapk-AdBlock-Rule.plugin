#!name = 去广告·淘宝/酷安（规则版）
#!desc = 与「去广告·淘宝/天猫/酷安」同一份域名清单，改用 Rule 规则在连接层直接拦截。不需要开启 MitM，不做证书解密，适合不想装证书或想彻底掐断广告域名的场景。
#!author = imacte
#!homepage = https://github.com/imacte/Loon-plugins
#!icon = https://raw.githubusercontent.com/imacte/Loon-plugins/main/icons/Taobao-Coolapk-AdBlock-Rule.png
#!system = iOS,iPadOS,macOS
#!system_version = 15.0
#!loon_version = 3.5.1(978)
#!tag = 去广告,淘宝,天猫,酷安
#!type = normal

# 说明：
#   1. 本插件只含 [Rule]，不需要 MitM，也不消耗流量解密。
#   2. 插件内规则只能用 DIRECT / REJECT 系列 / PROXY，所以这里全部用 REJECT 系列，
#      不提供开关（Loon 插件规则不支持参数化）。需要按需开关请用 Rewrite 版插件。
#   3. 不要用 DOMAIN-SUFFIX 拦 *.taobao.com / *.alicdn.com / *.tmall.com / *.ele.me，
#      会连带干掉正常业务；下面只列纯广告与埋点域名。

[Rule]

# ── 广告 SDK ──
DOMAIN-SUFFIX,tanx.com,REJECT-DICT
DOMAIN,shuzilm.cn,REJECT-DICT
DOMAIN-SUFFIX,shuzilm.cn,REJECT-DICT
DOMAIN,iuni.telecome.cn,REJECT
DOMAIN,lf-cdn-tos.bytescm.com,REJECT
DOMAIN,webcast-open.douyin.com,REJECT-DICT
DOMAIN,mssdk.volces.com,REJECT
DOMAIN,apmplus.volces.com,REJECT
DOMAIN,dg.k.jd.com,REJECT
DOMAIN,dgstatic.jd.com,REJECT

# ── 淘宝 / 天猫 广告接口 ──
DOMAIN,adashx.m.taobao.com,REJECT-DICT
DOMAIN,h-adashx.ut.taobao.com,REJECT-DICT
DOMAIN,alimama.cloudvideocdn.taobao.com,REJECT
DOMAIN,mamasearchad.cloudvideocdn.taobao.com,REJECT
DOMAIN,admedia.elemecdn.com,REJECT
DOMAIN,o2o-ad-dev.oss-cn-shanghai.aliyuncs.com,REJECT

# ── 埋点 / 统计 / 日志上报 ──
DOMAIN-SUFFIX,mmstat.com,REJECT
DOMAIN,loggw-ex.alipay.com,REJECT
DOMAIN,client-upload.cn-shanghai.log.aliyuncs.com,REJECT
DOMAIN,impaas-for-client.cn-shanghai.log.aliyuncs.com,REJECT

# ── 设备指纹 ──
DOMAIN,fourier.taobao.com,REJECT
DOMAIN,fourier.alibaba.com,REJECT
DOMAIN,cdn.ynuf.aliapp.org,REJECT-DICT
DOMAIN,alsc-fingerprint.ele.me,REJECT

# ── 可选：默认开启但风险略高，出问题就注释掉这几行 ──
# 阿里安全无痕验证，拦了可能出现登录异常或「系统繁忙」
# DOMAIN-SUFFIX,alibabachengdun.com,REJECT-DICT
# 天猫推广落地页 / 淘宝营销弹窗模板，拦了会连带干掉正常活动页
# DOMAIN,pages.tmall.com,REJECT
